# Укажите именно каталог, который уже подключён к работающему Spoolman.
# Не оставляйте пример пути без проверки в Container Manager.
SPOOLMAN_DATA_DIR=/volume1/docker/spoolman

SPOOLMAN_VERSION=0.26.1
SPOOLMAN_HTTP_PORT=7912
TZ=Europe/Moscow

# Скопируйте значения PUID и PGID из текущего контейнера.
PUID=1000
PGID=1000
